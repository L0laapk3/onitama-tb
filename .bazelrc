build --repo_env=CC=clang-23
build --action_env=CC=clang-23
build --linkopt=-fuse-ld=lld-23
build --cxxopt='-std=c++26'
build --cxxopt=-fcolor-diagnostics

common --experimental_cpp_modules
common --repo_env=BAZEL_DETECT_STD_MODULE=1
build --features=cpp_modules
build --features=std_module
build --cxxopt=-fmodules-embed-all-files
build --repo_env=BAZEL_LINKLIBS=-lc++:-lm
build --repo_env=BAZEL_CXXOPTS=-std=c++26:-stdlib=libc++
build --linkopt=-stdlib=libc++

build --cpu=local
build --cxxopt='-march=native'
build --cxxopt='-fconstexpr-steps=10000000'

build --cxxopt='-Wall'
build --cxxopt='-Werror'
build --cxxopt='-Wpedantic'
build --cxxopt='-Wno-unused-parameter'
build --cxxopt='-Wno-missing-braces'
build --cxxopt='-Wno-unused-variable'
build --cxxopt='-Wno-unused-but-set-variable'
build --cxxopt='-Wno-unused-function'
build --cxxopt='-Wno-unused-private-field'
build --cxxopt='-Wno-switch'
build --cxxopt='-Wno-language-extension-token'
build --cxxopt='-Wno-gnu-anonymous-struct'
build --cxxopt='-Wno-nested-anon-types'

# Default build: release
build --copt=-O3 --copt=-ffast-math --copt=-flto --linkopt=-flto
build --copt=-DNDEBUG
build --strip=always

build:turin --cxxopt=-march=znver5
build:turin --linkopt=-static
build:emerald --cxxopt=-march=emeraldrapids
build:emerald --linkopt=-static

build:symbols --copt=-g --strip=never

build:dbg --config=symbols
build:dbg --copt=-UNDEBUG
build:dbg --copt=-O0 --copt=-fno-fast-math --copt=-fno-lto --linkopt=-fno-lto
build:dbg --copt=-fno-omit-frame-pointer
build:dbg --compilation_mode=dbg
build:dbg --copt=-fsanitize=address,undefined
build:dbg --linkopt=-fsanitize=address,undefined
build:dbg --copt=-D_GLIBCXX_ASSERTIONS
build:dbg --copt=-D_GLIBCXX_DEBUG
build:dbg --copt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG
